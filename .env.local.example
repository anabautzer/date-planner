# Copie este arquivo para ".env.local" (que já está no .gitignore) e
# preencha com suas chaves reais. Nunca commite ".env.local".
#
# Veja o passo a passo para gerar cada chave em GUIA_API_KEYS.md

# ── TMDB (The Movie Database) ──────────────────────────────────────
# Usada em components/tabs/MoviesTab.tsx para buscar filmes em cartaz.
# É uma chamada server-side (Bearer token), por isso NÃO leva o prefixo
# NEXT_PUBLIC_ — fica oculta do navegador.
TMDB_API_TOKEN=

# ── Google Maps Platform (Places + Directions) ─────────────────────
# Usada em components/tabs/PlacesTab.tsx para autocomplete de locais e
# o trajeto do match. Precisa do prefixo NEXT_PUBLIC_ porque o SDK do
# Maps roda no navegador (client-side).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Upstash Redis (armazena os convites) ────────────────────────────
# Usada em lib/store.ts para salvar o convite do Host e as respostas
# do Guest, com expiração automática em 30 dias. Gerada ao conectar a
# integração Upstash pelo Vercel Marketplace (aba Storage do projeto).
# Dependendo de como a integração foi conectada, os nomes injetados podem
# variar (ex: UPSTASH_REDIS_REST_KV_URL) — lib/store.ts já reconhece as
# variações mais comuns automaticamente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
